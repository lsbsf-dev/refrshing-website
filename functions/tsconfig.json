{
  "compilerOptions": {
    "module": "commonjs",
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "outDir": "lib",
    "sourceMap": true,
    "strict": true,
    "target": "es2022",
    "moduleResolution": "node"
  },
  "exclude": [
    "../node_modules/@types/request",
    "../node_modules/tough-cookie"
  ],
  "compileOnSave": true,
  "include": [
    "src"
  ]
}
