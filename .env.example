# Environment variables template for Refreshing 2026 Firebase client configuration.
# Duplicate this file to .env.local and populate with your own project credentials.

# Active Conference Event ID mapping scope
NEXT_PUBLIC_ACTIVE_EVENT_ID=refreshing-2026

# Firebase Client API Credentials
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# Server-only Administrator Passkey for Seeding database
ADMIN_SEED_SECRET=your_seed_secret_key_here

