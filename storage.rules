rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Helper functions for checking authentication and roles
    function isAuthenticated() {
      return request.auth != null;
    }

    function hasRole(role) {
      return isAuthenticated() && request.auth.token.role == role;
    }

    function isEditorOrSuperAdmin() {
      return hasRole('superadmin') || hasRole('editor');
    }

    // Helper functions for validating file uploads
    function isValidImage() {
      // Allow image content types (jpeg, png, webp, etc.)
      return request.resource.contentType.matches('image/.*');
    }

    function isValidFileSize() {
      // Max file size: 5MB (5 * 1024 * 1024 = 5242880 bytes)
      return request.resource.size < 5 * 1024 * 1024;
    }

    // Public Assets (Ministers photos, event banners, etc.)
    // Anyone can read. Only editors/superadmins can upload or delete.
    match /public/{allPaths=**} {
      allow read: if true;
      allow write, delete: if isEditorOrSuperAdmin() && (request.method == 'delete' || (isValidImage() && isValidFileSize()));
    }

    // Explicitly reject all other access by default
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
